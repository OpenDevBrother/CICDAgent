# OCI tenant/runtime
OCI_REGION=us-ashburn-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..replace_me
OCI_AD=Uocm:US-ASHBURN-AD-1

# Free-tier guardrails (recommended)
OCI_INSTANCE_SHAPE=VM.Standard.A1.Flex
OCI_INSTANCE_OCPUS=2
OCI_INSTANCE_MEMORY_GB=12
OCI_BOOT_VOLUME_GB=50

# Network
OCI_VCN_CIDR=10.20.0.0/16
OCI_SUBNET_CIDR=10.20.1.0/24
OCI_PUBLIC_SSH_CIDR=0.0.0.0/0
OCI_ALLOW_HTTP_CIDR=0.0.0.0/0
OCI_ALLOW_HTTPS_CIDR=0.0.0.0/0

# Naming
OCI_DISPLAY_PREFIX=sentinelqa
OCI_INSTANCE_NAME=sentinelqa-app-a1

# SSH
OCI_SSH_PUBLIC_KEY_PATH=$HOME/.ssh/id_rsa.pub
OCI_SSH_PRIVATE_KEY_PATH=$HOME/.ssh/id_rsa
OCI_SSH_USER=ubuntu

# Optional
# OCI_IMAGE_ID=ocid1.image.oc1..replace_me
# OCI_SUBNET_ID=ocid1.subnet.oc1..replace_me
# TARGET_REPO_URL=https://github.com/Manjunath5513/TestingQA.git
