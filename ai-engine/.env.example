# Default provider for Architect node: openai | anthropic
LLM_PROVIDER=openai

# OpenAI (recommended if you already have this key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_REAL_ONLY=false

# Optional Anthropic support
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Phase 2: backend execution settings
RUN_TESTS_MODE=api
SENTINEL_BACKEND_URL=http://localhost:3000
TARGET_URL=http://localhost:3000
RUN_TESTS_TIMEOUT_SECONDS=60

# AWS Bedrock (multi-model per agent)
# LLM_PROVIDER=bedrock
AWS_BEDROCK_REGION=us-east-1
ARCHITECT_BEDROCK_MODEL=qwen.qwen3-coder-next
HEALER_BEDROCK_MODEL=deepseek.v3.2
JUDGE_BEDROCK_MODEL=zai.glm-5

# Embeddings (independent of LLM_PROVIDER)
# EMBEDDING_PROVIDER=bedrock
EMBEDDING_BEDROCK_MODEL=amazon.titan-embed-text-v2:0
